# Backend environment variables for Food Expiry Tracker

# App
APP_NAME=Food Expiry Tracker API

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/food_tracker

# JWT
JWT_SECRET_KEY=change-me-in-production-with-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Resend email notifications (optional)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Food Expiry Tracker <onboarding@resend.dev>
RESEND_TO_EMAILS=

# Expiry alert window in days
EXPIRY_ALERT_DAYS=7
